# DeepSeek API 密钥（必填，在 Netlify 环境变量中配置，切勿提交到仓库）
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址（可选，默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称（可选，默认 deepseek-v4-pro；可改为 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-pro

# 允许跨域访问的前端站点域名（可选，生产环境建议设为你自己的子域名，防止滥用）
ALLOWED_ORIGIN=https://your-domain.com